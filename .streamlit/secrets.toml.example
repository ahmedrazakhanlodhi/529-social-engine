# Copy to .streamlit/secrets.toml locally, or paste into the Streamlit Cloud
# "Secrets" box. All entries are optional; the app runs without them.

# Locks the app to you and Catherine.
app_password = "change-me"

# Turns on durable shared storage (calendar + campaign) in Google Sheets.
# Without this the app uses a local CSV that resets when the server reboots.
# Reuse your existing service account. Share the target Sheet with its
# client_email, then paste the Sheet id below.
sheet_id = "PASTE_GOOGLE_SHEET_ID"

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
